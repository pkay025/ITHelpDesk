@page "/"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Help Desk Dashboard</PageTitle>

<div class="dashboard-shell">
	<div class="dashboard-heading">
		<div>
			<p class="eyebrow">IT OPERATIONS</p>
			<h1>Help Desk Dashboard</h1>
			<p class="lead">A clear view of every support request, from first report to resolution.</p>
		</div>
		<a class="btn btn-primary" href="submit-ticket">Submit a ticket</a>
	</div>

	@if (tickets is null)
	{
		<p class="status-message">Loading ticket activity...</p>
	}
	else
	{
		<div class="metric-grid">
			<div class="metric-card metric-open"><span>Open</span><strong>@OpenCount</strong><small>Needs attention</small></div>
			<div class="metric-card metric-progress"><span>In progress</span><strong>@InProgressCount</strong><small>Being worked on</small></div>
			<div class="metric-card metric-resolved"><span>Resolved</span><strong>@ResolvedCount</strong><small>Completed recently</small></div>
			<div class="metric-card metric-total"><span>Total requests</span><strong>@tickets.Count</strong><small>Across all statuses</small></div>
		</div>

		<section class="panel recent-panel">
			<div class="panel-heading"><div><p class="eyebrow">LIVE QUEUE</p><h2>Recent requests</h2></div><a href="staff-queue">View full queue</a></div>
			@if (tickets.Count == 0)
			{
				<p class="empty-state">No tickets yet. Submit the first request to get started.</p>
			}
			else
			{
				<div class="ticket-list">
					@foreach (var ticket in tickets.Take(5))
					{
						<div class="ticket-row">
							<div><strong>#@ticket.Id · @ticket.Title</strong><small>@ticket.RequesterName · @ticket.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small></div>
							<span class="status-pill status-@ticket.Status.ToString().ToLowerInvariant()">@ticket.Status</span>
						</div>
					}
				</div>
			}
		</section>
	}
</div>

@code {
	private List<Ticket>? tickets;

	private int OpenCount => tickets?.Count(ticket => ticket.Status is TicketStatus.Open or TicketStatus.Assigned) ?? 0;
	private int InProgressCount => tickets?.Count(ticket => ticket.Status == TicketStatus.InProgress) ?? 0;
	private int ResolvedCount => tickets?.Count(ticket => ticket.Status is TicketStatus.Resolved or TicketStatus.Closed) ?? 0;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var client = HttpClientFactory.CreateClient("HelpDeskApi");
			tickets = await client.GetFromJsonAsync<List<Ticket>>("api/tickets") ?? [];
		}
		catch (HttpRequestException)
		{
			tickets = [];
		}
	}
}
