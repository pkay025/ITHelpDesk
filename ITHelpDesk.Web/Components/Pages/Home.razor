@page "/home"
@page "/student-dashboard"
@page "/student-home"
@rendermode InteractiveServer
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Student Dashboard | IT Help Desk</PageTitle>

@if (!AuthSession.IsAuthenticated || AuthSession.IsStaff)
{
    return;
}

<div class="dashboard-shell">
	<div class="dashboard-heading">
		<div>
			<p class="eyebrow">STUDENT PORTAL</p>
			<h1>Student Dashboard</h1>
			<p class="lead">Track your support requests, view status updates, and open active tickets.</p>
		</div>
		<div class="d-flex gap-2 align-items-center">
			<a class="btn btn-primary" href="submit-ticket">Submit a ticket</a>
			<a class="btn btn-outline-primary" href="my-tickets">My tickets</a>
			@* <button class="btn btn-outline-danger" @onclick="HandleSignOut">Sign out</button> *@
		</div>
	</div>

	@if (tickets is null)
	{
		<p class="status-message">Loading your ticket activity...</p>
	}
	else
	{
		<div class="metric-grid">
			<div class="metric-card metric-open"><span>Open</span><strong>@OpenCount</strong><small>Needs attention</small></div>
			<div class="metric-card metric-progress"><span>In progress</span><strong>@InProgressCount</strong><small>Being worked on</small></div>
			<div class="metric-card metric-resolved"><span>Resolved</span><strong>@ResolvedCount</strong><small>Completed recently</small></div>
			<div class="metric-card metric-total"><span>Total requests</span><strong>@tickets.Count</strong><small>Across all statuses</small></div>
		</div>

		<section class="panel recent-panel">
			<div class="panel-heading">
				<div>
					<p class="eyebrow">MY TICKETS</p>
					<h2>Recent requests</h2>
				</div>
				<a href="my-tickets">View my tickets</a>
			</div>
			@if (tickets.Count == 0)
			{
				<p class="empty-state">You haven't submitted any support requests yet. <a href="submit-ticket">Submit your first request</a> to get started.</p>
			}
			else
			{
				<div class="ticket-list">
					@foreach (var ticket in tickets.Take(5))
					{
						<div class="ticket-row">
							<div>
								<strong><a href="tickets/@ticket.Id">#@ticket.Id · @ticket.Title</a></strong>
								<small>Created @ticket.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small>
							</div>
							<span class="status-pill status-@ticket.Status.ToString().ToLowerInvariant()">@ticket.Status</span>
						</div>
					}
				</div>
			}
		</section>
	}
</div>

@code {
	private List<Ticket>? tickets;

	private int OpenCount => tickets?.Count(ticket => ticket.Status is TicketStatus.Open or TicketStatus.Assigned) ?? 0;
	private int InProgressCount => tickets?.Count(ticket => ticket.Status == TicketStatus.InProgress) ?? 0;
	private int ResolvedCount => tickets?.Count(ticket => ticket.Status is TicketStatus.Resolved or TicketStatus.Closed) ?? 0;

	protected override async Task OnInitializedAsync()
	{
		AuthSession.OnChange += HandleAuthChange;
		if (AuthSession.IsInitialized)
		{
			await CheckAccessAndLoadAsync();
		}
	}

	public void Dispose()
	{
		AuthSession.OnChange -= HandleAuthChange;
	}

	private async void HandleAuthChange()
	{
		await InvokeAsync(async () =>
		{
			await CheckAccessAndLoadAsync();
			StateHasChanged();
		});
	}

	private async Task CheckAccessAndLoadAsync()
	{
		if (!AuthSession.IsAuthenticated)
		{
			NavigationManager.NavigateTo("login", replace: true);
			return;
		}

		if (AuthSession.IsStaff)
		{
			NavigationManager.NavigateTo("dashboard", replace: true);
			return;
		}

		await LoadTicketsAsync();
	}

	private async Task LoadTicketsAsync()
	{
		if (string.IsNullOrWhiteSpace(AuthSession.Email))
		{
			tickets = [];
			return;
		}

		try
		{
			var client = HttpClientFactory.CreateClient("HelpDeskApi");
			var emailParam = Uri.EscapeDataString(AuthSession.Email);
			tickets = await client.GetFromJsonAsync<List<Ticket>>($"api/tickets?requesterEmail={emailParam}") ?? [];
		}
		catch (HttpRequestException)
		{
			tickets = [];
		}
	}

	private async Task HandleSignOut()
	{
		try
		{
			await JSRuntime.InvokeVoidAsync("authStorage.remove", "ithelpdesk_auth");
		}
		catch
		{
		}

		AuthSession.SignOut();
		NavigationManager.NavigateTo("login");
	}
}
