@page "/register"
@rendermode InteractiveServer
@using ITHelpDesk.Core.Contracts
@using ITHelpDesk.Core.Enums
@using ITHelpDesk.Web.Services
@inject IHttpClientFactory HttpClientFactory
@inject AuthSession AuthSession
@inject NavigationManager NavigationManager

<PageTitle>Create Account | IT Help Desk</PageTitle>

<div class="auth-layout">
    <section class="auth-visual" aria-label="IT Help Desk workspace">
        <div class="auth-visual-overlay">
            <span class="auth-brand">IT Help Desk</span>
            <div>
                <p class="eyebrow">YOUR SUPPORT DESK</p>
                <h1>Help starts here.</h1>
                <p>One place to ask questions, share context, and see every request through.</p>
            </div>
        </div>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-content">
            <p class="eyebrow">CREATE AN ACCOUNT</p>
            <h2>CREATE AN ACCOUNT</h2>
            <p class="auth-subtitle">Sign up for IT Help Desk</p>
            <p class="lead">Register as a student or staff member to submit and track support requests.</p>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <EditForm Model="request" OnValidSubmit="RegisterAsync" class="auth-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-field">
                    <label for="name">Full name</label>
                    <InputText id="name" @bind-Value="request.Name" placeholder="Full Name" />
                    <ValidationMessage For="@(() => request.Name)" />
                </div>

                <div class="form-field">
                    <label for="email">Email address</label>
                    <InputText id="email" type="email" @bind-Value="request.Email" placeholder="Email Address" />
                    <ValidationMessage For="@(() => request.Email)" />
                </div>

                <div class="form-field">
                    <label for="password">Password</label>
                    <div class="password-field">
                        <InputText id="password" type="@(showPassword ? "text" : "password")" @bind-Value="request.Password" placeholder="Password" />
                        <button type="button" class="password-toggle" @onclick="TogglePassword" aria-label="@(showPassword ? "Hide password" : "Show password")">@(showPassword ? "Hide" : "Show")</button>
                    </div>
                    <small class="field-hint">Use at least 8 characters.</small>
                    <ValidationMessage For="@(() => request.Password)" />
                </div>

                <div class="form-field">
                    <label for="userType">Account type</label>
                    <InputSelect id="userType" @bind-Value="request.UserType">
                        <option value="@UserType.Student">Student</option>
                        <option value="@UserType.Staff">Staff</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => request.UserType)" />
                </div>

                <button class="btn btn-primary auth-submit" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Creating account..." : "Create Account")
                </button>
            </EditForm>

            <p class="auth-switch">Already have an account? <a href="login">Sign in here.</a></p>
        </div>
    </section>
</div>

@code {
    private RegisterRequest request = new();
    private bool isSubmitting;
    private bool showPassword;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        if (AuthSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo(AuthSession.IsStaff ? "dashboard" : "home", replace: true);
        }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task RegisterAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("HelpDeskApi");
            var registerResponse = await client.PostAsJsonAsync("api/auth/register", request);

            if (!registerResponse.IsSuccessStatusCode)
            {
                errorMessage = registerResponse.StatusCode == System.Net.HttpStatusCode.BadRequest
                    ? "That email may already be registered, or some information needs attention."
                    : "We couldn't create your account. Please try again.";
                return;
            }

            NavigationManager.NavigateTo("login");
        }
        catch (HttpRequestException)
        {
            errorMessage = "The API is unavailable. Start the API project and try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
