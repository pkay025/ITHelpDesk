@inherits LayoutComponentBase
@implements IDisposable
@inject ITHelpDesk.Web.Services.AuthSession AuthSession
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (AuthSession.IsAuthenticated)
            {
                <span class="user-info me-3">
                    <strong>@(AuthSession.Name ?? AuthSession.Email)</strong>
                    <span class="badge bg-secondary ms-1">@AuthSession.UserType</span>
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="HandleSignOut">Sign out</button>
            }
            else
            {
                <a href="login">Sign in</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthSession.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthSession.OnChange -= StateHasChanged;
    }

    private void HandleSignOut()
    {
        AuthSession.SignOut();
        NavigationManager.NavigateTo("");
    }
}
