@inherits LayoutComponentBase
@implements IDisposable
@inject ITHelpDesk.Web.Services.AuthSession AuthSession
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (IsAuthenticationPage)
{
    <main class="auth-main">
        <article class="auth-content">
            @Body
        </article>
    </main>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                @if (AuthSession.IsAuthenticated)
                {
                    <span class="user-info me-3">
                        <strong>@(AuthSession.Name ?? AuthSession.Email)</strong>
                        <span class="badge bg-secondary ms-1">@AuthSession.UserType</span>
                    </span>
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" @onclick="HandleSignOut">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z"/>
                            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z"/>
                        </svg>
                        Sign out
                    </button>
                }
                else
                {
                    <a href="login">Sign in</a>
                }
            </div>

            <article class="content px-4">
                @if (!IsUnauthorizedRoute())
                {
                    @Body
                }
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsAuthenticationPage { get; set; }

    protected override void OnInitialized()
    {
        AuthSession.OnChange += HandleAuthChange;
        NavigationManager.LocationChanged += HandleLocationChanged;
        UpdateAuthenticationPage();
        if (AuthSession.IsInitialized)
        {
            EnforceRouteProtection();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !AuthSession.IsInitialized)
        {
            try
            {
                var json = await JSRuntime.InvokeAsync<string?>("authStorage.get", "ithelpdesk_auth");
                if (!string.IsNullOrWhiteSpace(json))
                {
                    var auth = System.Text.Json.JsonSerializer.Deserialize<AuthenticationResponse>(json);
                    if (auth is not null && !string.IsNullOrWhiteSpace(auth.Token))
                    {
                        AuthSession.SignIn(auth);
                    }
                }
            }
            catch
            {
                // Browser storage unavailable or blocked
            }
            finally
            {
                AuthSession.IsInitialized = true;
                EnforceRouteProtection();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    public void Dispose()
    {
        AuthSession.OnChange -= HandleAuthChange;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private void HandleAuthChange()
    {
        EnforceRouteProtection();
        InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        UpdateAuthenticationPage();
        EnforceRouteProtection();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateAuthenticationPage()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .Trim('/');
        IsAuthenticationPage = path is "" or "login" or "register";
    }

    private bool IsUnauthorizedRoute()
    {
        if (!AuthSession.IsInitialized) return false;

        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();

        if (relativePath is "" or "login" or "register" or "error" or "not-found")
        {
            return false;
        }

        if (!AuthSession.IsAuthenticated) return true;

        if (AuthSession.IsStaff && relativePath is "submit-ticket" or "my-tickets" or "home" or "student-home" or "student-dashboard")
        {
            return true;
        }

        if (!AuthSession.IsStaff && relativePath is "dashboard" or "staff-dashboard" or "staff-queue")
        {
            return true;
        }

        return false;
    }

    private void EnforceRouteProtection()
    {
        if (!AuthSession.IsInitialized) return;

        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .Split('?', '#')[0]
            .Trim('/')
            .ToLowerInvariant();

        if (relativePath is "" or "login" or "register" or "error" or "not-found")
        {
            if (AuthSession.IsAuthenticated && relativePath is "" or "login" or "register")
            {
                NavigationManager.NavigateTo(AuthSession.IsStaff ? "dashboard" : "home", replace: true);
            }
            return;
        }

        if (!AuthSession.IsAuthenticated)
        {
            NavigationManager.NavigateTo("login", replace: true);
            return;
        }

        if (AuthSession.IsStaff)
        {
            if (relativePath is "submit-ticket" or "my-tickets" or "home" or "student-home" or "student-dashboard")
            {
                NavigationManager.NavigateTo("dashboard", replace: true);
            }
        }
        else
        {
            if (relativePath is "dashboard" or "staff-dashboard" or "staff-queue")
            {
                NavigationManager.NavigateTo("home", replace: true);
            }
        }
    }

    private async Task HandleSignOut()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("authStorage.remove", "ithelpdesk_auth");
        }
        catch
        {
        }

        AuthSession.SignOut();
        NavigationManager.NavigateTo("login");
    }
}
